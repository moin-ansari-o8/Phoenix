# NOTE: gitignore has NO inline comment syntax.
# `*.wav  # temp audio` matches a file literally named `*.wav  # temp audio`.
# Keep every comment on its own line.

# Python
__pycache__/
*.py[cod]
*.pyo

# Virtual environments
.venv/
.venv_new/
venv/

# IDE / OS
.DS_Store
Thumbs.db
desktop.ini
*.swp
.vscode/
.idea/

# Secrets
.env
secret_config.json

# Node
node_modules/
package-lock.json

# Logs
*.log
*.log.*
logs/

# Temp and build artifacts
*.tmp
*.bak
temp/
dist/
build/
*.egg-info/
SortPythonProgram.pyd

# Generated audio.
# TTS writes uniquely-named temp files into data/; they are never source.
*.wav
*.mp3
data/phoenix_speech_*.mp3
test_*_output.*

# Assets are audio too, but they ARE source - keep them tracked.
!assets/sound/*.wav
!assets/sound/*.mp3

# Large models - download separately, never commit.
# voice/ held Piper .onnx voices. Piper was dropped 2026-08-12 in favour of
# SAPI5; the directory is unused and can be deleted to reclaim ~121 MB.
*.onnx
voice/
models/

# Runtime state / private data
data/*.json.bak
data/*.bak
data/ChatLog.json
data/remember.md
data/remember.json
# Listening habits. Regenerates itself from use; songs.txt is the shared part.
data/song_stats.json

# Voice biometrics. Derived from recordings of the user, tied to this machine's
# microphone, and useless anywhere else - never commit either of these.
data/speaker_profile.npz
data/voice_enroll/

# Experiments
trials/
*.zip
